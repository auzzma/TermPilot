1 ICON "TermPilot.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION VERSION_COMPONENTS
PRODUCTVERSION VERSION_COMPONENTS
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "TermPilot\0"
            VALUE "FileDescription", "TermPilot\0"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "TermPilot\0"
            VALUE "OriginalFilename", "TermPilot.exe\0"
            VALUE "ProductName", "TermPilot\0"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
