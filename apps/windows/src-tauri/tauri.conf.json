{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermPilot",
  "version": "0.2.0",
  "identifier": "com.termpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "TermPilot",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/AutocompleteSpecs.bundledata": "AutocompleteSpecs.bundledata",
      "../public/AutocompleteSpecs.LICENSE": "licenses/AutocompleteSpecs.LICENSE"
    },
    "shortDescription": "Terminal and SSH workspace",
    "longDescription": "TermPilot Windows terminal and remote management workspace."
  }
}
