# Apply to the codec and its vendored C/C++ dependencies, including __FILE__.
get_filename_component(_termpilot_source_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(WIN32)
  file(TO_CMAKE_PATH "$ENV{USERPROFILE}" _termpilot_build_home)
else()
  set(_termpilot_build_home "$ENV{HOME}")
endif()
if(MSVC)
  add_compile_options("/experimental:deterministic")
endif()
function(_termpilot_map_source source destination)
  if(MSVC)
    # MSVC can emit both spellings in a single object file. CMake normalizes
    # its paths to '/', but CodeView also needs the native '\' mapping.
    file(TO_NATIVE_PATH "${source}" native_source)
    add_compile_options("/pathmap:${source}=${destination}" "/pathmap:${native_source}=${destination}")
  else()
    add_compile_options("-ffile-prefix-map=${source}=${destination}")
  endif()
endfunction()
_termpilot_map_source("${_termpilot_build_home}" "/build/user")
_termpilot_map_source("${_termpilot_source_root}" "/build/termpilot")
if(MSVC)
  add_link_options("/PDBALTPATH:%_PDB%")
endif()
